rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ランキング用：scores/{ユーザーID}
    match /scores/{userId} {

      // ランキングは誰でも見られる
      allow read: if true;

      // 初めての記録：ログインしていて、自分のIDのドキュメントだけ作れる
      allow create: if isOwner(userId) && isValidScore();

      // 記録の更新：自分のドキュメントだけ、しかも前の記録より高いときだけ
      allow update: if isOwner(userId) && isValidScore()
                    && request.resource.data.best > resource.data.best;

      // 削除は禁止
      allow delete: if false;
    }

    // 設定用：settings/{ユーザーID}
    // 自分の設定だけ読み書きできる（他人の設定は見えない）
    match /settings/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidSettings();
      allow delete: if isOwner(userId);
    }

    // ---- 関数 ----
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidScore() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'best', 'updatedAt'])
          && d.keys().hasOnly(['name', 'best', 'updatedAt'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
          && d.best is int && d.best >= 0 && d.best <= 100000
          && d.updatedAt == request.time;
    }

    function isValidSettings() {
      let d = request.resource.data;
      return d.keys().hasAll(['keyLeft', 'keyRight', 'seVolume', 'bgmVolume', 'updatedAt'])
          && d.keys().hasOnly(['keyLeft', 'keyRight', 'seVolume', 'bgmVolume', 'updatedAt'])
          && d.keyLeft is string && d.keyLeft.size() >= 1 && d.keyLeft.size() <= 32
          && d.keyRight is string && d.keyRight.size() >= 1 && d.keyRight.size() <= 32
          && d.keyLeft != d.keyRight
          && d.seVolume is number && d.seVolume >= 0 && d.seVolume <= 1
          && d.bgmVolume is number && d.bgmVolume >= 0 && d.bgmVolume <= 1
          && d.updatedAt == request.time;
    }
  }
}
